      {
        "comment": "",
        "key": "Sweep mode",
        "location": {
          "startingColumn": 22,
          "startingLine": 468
        }
      },
      {
        "comment": "",
        "key": "What happens to swept apps",
        "location": {
          "startingColumn": 58,
          "startingLine": 472
        }
      },
      {
        "comment": "",
        "key": "Apps are asked to quit politely — unsaved work always gets a save dialog, and Finder is only hidden. Restore reopens everything. Saves battery.",
        "location": {
          "startingColumn": 57,
          "startingLine": 474
        }
      },
      {
        "comment": "",
        "key": "Apps are hidden, never quit. Restore is instant and nothing can be lost.",
        "location": {
          "startingColumn": 57,
          "startingLine": 475
        }
      },
      {
        "comment": "",
        "key": "Reopen automatically",
        "location": {
          "startingColumn": 58,
          "startingLine": 488
        }
      },
      {
        "comment": "",
        "key": "After a sweep, bring the whole session back by itself — get back in the flow.",
        "location": {
          "startingColumn": 60,
          "startingLine": 489
        }
      },
      {
        "comment": "",
        "key": "",
        "location": {
          "startingColumn": 32,
          "startingLine": 476
        }
      },
      {
        "comment": "",
        "key": "",
        "location": {
          "startingColumn": 32,
          "startingLine": 490
        }
      },
      {
        "comment": "",
        "key": "Permissions",
        "location": {
          "startingColumn": 22,
          "startingLine": 502
        }
      },
      {
        "comment": "",
        "key": "Accessibility",
        "location": {
          "startingColumn": 58,
          "startingLine": 506
        }
      },
      {
        "comment": "",
        "key": "Granted — full-screen and split-view apps are hidden too.",
        "location": {
          "startingColumn": 57,
          "startingLine": 508
        }
      },
      {
        "comment": "",
        "key": "Not granted — full-screen and split-view windows can't be hidden. Normal windows still work.",
        "location": {
          "startingColumn": 57,
          "startingLine": 509
        }
      },
      {
        "comment": "",
        "key": "Open System Settings…",
        "location": {
          "startingColumn": 54,
          "startingLine": 511
        }
      },
      {
        "comment": "",
        "key": "Never hide these apps",
        "location": {
          "startingColumn": 22,
          "startingLine": 521
        }
      },
      {
        "comment": "",
        "key": "Turn an app ON to protect it — Sweep will never hide it. Everything OFF here gets swept. Sweep itself is always protected.",
        "location": {
          "startingColumn": 30,
          "startingLine": 524
        }
      },

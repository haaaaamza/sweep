      },
      {
        "comment": "",
        "key": "Header, kind badge, thumbnail strip and key hints — the balanced default.",
        "location": {
          "startingColumn": 38,
          "startingLine": 38
        }
      },
      {
        "comment": "",
        "key": "Radically minimal, faithful to the original Flycut: source, the clipping, a counter.",
        "location": {
          "startingColumn": 38,
          "startingLine": 40
        }
      },
      {
        "comment": "",
        "key": "The previous and next clippings peek from the sides, cover-flow style.",
        "location": {
          "startingColumn": 38,
          "startingLine": 42
        }
      },
      {
        "comment": "",
        "key": "Big thumbnails are the interface; a slim preview sits above them.",
        "location": {
          "startingColumn": 38,
          "startingLine": 44
        }
      },
      {
        "comment": "",
        "key": "A vertical list with a preview pane — best for long histories and long text.",
        "location": {
          "startingColumn": 38,
          "startingLine": 46
        }
      },
      {
        "comment": "",
        "key": "A wide shelf of cards that slides up from the bottom of the screen.",
        "location": {
          "startingColumn": 38,
          "startingLine": 48
        }
      },
      {
        "comment": "",
        "key": "A one-line capsule near the top of the screen, like a volume HUD.",
        "location": {
          "startingColumn": 38,
          "startingLine": 50
        }
      },
      {
        "comment": "",
        "key": "The clipping front and center; app, time and size in a quiet right rail.",
        "location": {
          "startingColumn": 38,
          "startingLine": 52
        }
      },
      {
        "comment": "",
        "key": "A 3×3 board of the last 9 clippings — press 1–9 to pick instantly.",
        "location": {
          "startingColumn": 38,
          "startingLine": 54
        }
      },
      {
        "comment": "",
        "key": "Nothing copied yet",
